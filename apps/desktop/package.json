{
  "name": "@momentum/desktop",
  "version": "1.0.0",
  "private": true,
  "description": "MOMENTUM Windows desktop shell (Electron)",
  "author": "MOMENTUM",
  "main": "main.cjs",
  "scripts": {
    "prepare:web": "node scripts/copy-web.cjs",
    "prepare:runtime": "node scripts/prepare-runtime.cjs",
    "start": "electron .",
    "start:dev": "electron . --dev",
    "dist": "npm run prepare:web && npm run prepare:runtime && electron-builder --win --x64",
    "dist:dir": "npm run prepare:web && npm run prepare:runtime && electron-builder --win --x64 --dir"
  },
  "build": {
    "appId": "com.momentum.desktop",
    "productName": "MOMENTUM",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.cjs",
      "backend.cjs",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../web/dist",
        "to": "web"
      },
      {
        "from": "../../services/api/build/momentum-api.jar",
        "to": "api/momentum-api.jar"
      },
      {
        "from": "runtime.env",
        "to": "runtime.env"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "MOMENTUM"
    }
  },
  "devDependencies": {
    "electron": "^45.2.2",
    "electron-builder": "^26.0.12"
  }
}
