# MOMENTUM server configuration. Copy to .env and keep it out of source control.
# scripts/start.ps1 loads this file automatically.

# --- Network ---------------------------------------------------------------
MOMENTUM_HOST=127.0.0.1
MOMENTUM_PORT=8787
# The public origin that serves this app (used for OAuth callbacks).
MOMENTUM_PUBLIC_URL=http://127.0.0.1:8787
# Where users land after OAuth. In development, point at Vite.
MOMENTUM_APP_URL=http://127.0.0.1:5173
MOMENTUM_COOKIE_SECURE=false
# Comma-separated additional browser origins, e.g. Capacitor shells.
MOMENTUM_ALLOWED_ORIGINS=

# --- Storage ---------------------------------------------------------------
MOMENTUM_DATA_DIR=data
MOMENTUM_WEB_DIST=apps/web/dist

# --- AI --------------------------------------------------------------------
# Optional comma-separated provider allowlist. Empty means all providers.
# The delivered local build sets this to "groq".
MOMENTUM_AI_PROVIDERS=
# Local desktop mode may use the server-side key for loopback requests without
# requiring an account. Only enable this on a machine you control.
MOMENTUM_ALLOW_LOCAL_AI_KEY=false

# Optional server-side keys. User-entered keys always take precedence.
# Server keys are used for authenticated users, or loopback requests when
# MOMENTUM_ALLOW_LOCAL_AI_KEY=true. Keys are never sent to browsers.
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# Ollama defaults to http://127.0.0.1:11434. Set this only for an explicitly
# trusted operator-managed endpoint.
MOMENTUM_OLLAMA_URL=

# Custom OpenAI-compatible providers are opt-in and host-allowlisted to avoid SSRF.
MOMENTUM_ALLOW_CUSTOM_AI=false
MOMENTUM_CUSTOM_AI_HOSTS=

# --- OAuth -----------------------------------------------------------------
# Each provider is enabled only when both credentials are present.
# Register the redirect URI: ${MOMENTUM_PUBLIC_URL}/api/auth/oauth/<provider>/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
